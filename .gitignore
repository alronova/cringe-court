# --- Agent workspace / scratch (zwork and other agent setup) ---
.zwork/
.work/
.agent/
.hermmes/
*.zwork/

# --- Node / package dependencies ---
node_modules/
**/node_modules/

# --- Build / generated caches (keep explicit out/ artifacts that are tracked) ---
.cache/
.tmp/

# --- OS & editor junk ---
.DS_Store
Thumbs.db
*.swp
*~

# --- App build output ---
apps/*/dist/
packages/*/dist/
*.tsbuildinfo
coverage/

# --- Court server local data (JSON-lines store, generated secret) ---
.data/

# --- Court AI local secrets (see docs/ai/10). Only the .example file is tracked ---
.env.court
**/.env.court
.env.local
**/.env.local
.env*.local
**/.env*.local
apps/server/.env
.court-transcripts/
