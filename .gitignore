# --- Agent workspace / scratch (zwork and other agent setup) ---
.zwork/
.work/
.agent/
.hermmes/
*.zwork/

# --- Node / package dependencies ---
node_modules/
**/node_modules/

# --- Build / generated caches (keep explicit out/ artifacts that are tracked) ---
.cache/
.tmp/

# --- OS & editor junk ---
.DS_Store
Thumbs.db
*.swp
*~

# --- App build output ---
apps/*/dist/
packages/*/dist/
*.tsbuildinfo
coverage/

# --- Court server local data (JSON-lines store, generated secret) ---
.data/

# --- Playwright e2e (apps/web/e2e): build, report, results ---
apps/web/e2e/.dist/
apps/web/e2e/.report/
apps/web/e2e/.results/
